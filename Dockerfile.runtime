# Ubuntu JRE (glibc) required for Shenandoah GC; Alpine/musl does not include it.
ARG RUNTIME_IMAGE=eclipse-temurin:25-jre@sha256:ecdc0adb37bde1a281c4d245a3cd535004b1fc8322d560f5b09463b248c81df0
FROM ${RUNTIME_IMAGE}

WORKDIR /app

# Сервис ничего не пишет на диск, поэтому root ему не нужен ни для чего.
RUN useradd --system --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin app

COPY --chown=app:app app.jar app.jar

USER app

EXPOSE 8080

ENTRYPOINT ["java", \
  "-XX:+UseShenandoahGC", \
  "-XX:ShenandoahGCHeuristics=adaptive", \
  "-XX:MaxGCPauseMillis=10", \
  "-jar", "/app/app.jar"]
